[Unit]
Description=Dagster daemon (Default Predictor schedules + sensors)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/predictor
Environment=DAGSTER_HOME=/root/predictor/orchestration/dagster_home
# The daemon is what actually fires schedules. It must share DAGSTER_HOME with
# the webserver and load the same -f definitions file.
ExecStart=/root/predictor/.venv/bin/dagster-daemon run -f orchestration/definitions.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
